root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4
max_line_length = 88

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.rst]
indent_size = 3
max_line_length = 88

[Makefile]
indent_style = tab
